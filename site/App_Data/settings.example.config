<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to settings.config in the same folder ON THE SERVER and fill in the values.
  settings.config is never committed to git.
  In values, write & as &amp;   < as &lt;   " as &quot;  (passwords often contain these).
  Changes are picked up automatically; no restart needed.
-->
<appSettings>
  <!-- SQL Server connection string for the site's own database. -->
  <add key="ConnectionString" value="Server=localhost\MSSQLSERVER2014;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;" />

  <!-- Long random secret used once per device: https://your-site/enroll.ashx?key=THIS&name=iPhone -->
  <add key="EnrollKey" value="REPLACE_WITH_64_RANDOM_HEX_CHARS" />

  <!-- Set to false after all your devices are enrolled. -->
  <add key="EnrollOpen" value="true" />
  <add key="MaxDevices" value="3" />
  <add key="CookieName" value="gym_device" />
  <add key="CookieDays" value="390" />
</appSettings>
