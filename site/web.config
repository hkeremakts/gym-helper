<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Secrets live in App_Data\settings.config (not in git). It is read by App_Code\Settings.cs, not here. -->

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="4096" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" culture="en-US" uiCulture="en-US" />
    <!-- Off while building so errors are readable; switch to On before going live (PLAN Phase 8). -->
    <customErrors mode="Off" />
    <sessionState mode="Off" />
    <pages enableViewState="false" enableSessionState="false" validateRequest="false" />
  </system.web>

  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Robots-Tag" value="noindex, nofollow" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <!-- App_Data, App_Code, bin, .config and .cs are already blocked by IIS defaults;
             adding them again would be a duplicate-entry error. -->
        <fileExtensions>
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
